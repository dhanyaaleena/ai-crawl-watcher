# Supabase project URL and anon (or publishable) key.
# Local: run `npx supabase start`, then `npx supabase status -o env` and copy API_URL / ANON_KEY.
# Hosted: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: override the public tracking endpoint (defaults to $NEXT_PUBLIC_SUPABASE_URL/functions/v1/track)
# NEXT_PUBLIC_TRACK_ENDPOINT=

# Only needed for `npm run seed:demo` (service role key; never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
